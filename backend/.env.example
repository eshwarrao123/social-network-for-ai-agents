# ============================================================
# Asama.ai Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://asama:asama_pass@localhost:5432/asama_db
DATABASE_URL_SYNC=postgresql+psycopg2://asama:asama_pass@localhost:5432/asama_db
DATABASE_TEST_URL=postgresql+asyncpg://asama:asama_pass@localhost:5432/asama_test_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth & Security ---
JWT_SECRET_KEY=change-me-to-a-random-256-bit-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_EXPIRE_MINUTES=30  # Optional legacy alias
JWT_ISSUER=social-network-for-ai-agents
JWT_AUDIENCE=agent-network
# Symmetric encryption key for webhook secrets at rest (Fernet URL-safe base64 32-byte key)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_ENCRYPTION_KEY=change-me-to-a-valid-fernet-key
WEBHOOK_ALLOWED_PORTS=443,8443
WEBHOOK_CONNECT_TIMEOUT=3.0
WEBHOOK_READ_TIMEOUT=5.0
WEBHOOK_MAX_DELIVERY_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF_SECONDS=2.0
WEBHOOK_ALLOW_HTTP=false

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_ENDPOINT=/api/embed
EMBEDDING_DIMENSIONS=768
OLLAMA_CONNECT_TIMEOUT=5.0
OLLAMA_READ_TIMEOUT=30.0

# --- LLM Provider (choose one) ---
# Options: ollama | openai | anthropic | disabled
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_MAX_COMMENT_LENGTH=1000
LLM_MIN_CONFIDENCE=0.5
# If using openai:
# OPENAI_API_KEY=sk-...
# If using anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Feedback Learning (P7) ---
FEEDBACK_LEARNING_ENABLED=true
FEEDBACK_LEARNING_RATE_POS=0.08
FEEDBACK_LEARNING_RATE_NEG=0.04
FEEDBACK_MIN_CONFIDENCE=0.60
FEEDBACK_MIN_SAMPLES=3
FEEDBACK_ANCHOR_COSINE_MIN=0.70
FEEDBACK_WEIGHT=0.30
FEEDBACK_MAX_ADJUSTMENT=0.15
FEEDBACK_LEASE_DURATION_SECONDS=60

# --- Routing ---
ROUTING_ALPHA=0.65
ROUTING_THRESHOLD=0.60
MAX_NOTIFICATIONS_PER_POST=5
MAX_ROUTING_CANDIDATES=50
ROUTING_WEIGHT_INDUSTRY=0.30
ROUTING_WEIGHT_TAG=0.30
ROUTING_WEIGHT_CAPABILITY=0.25
ROUTING_WEIGHT_DIVERSITY=0.10
ROUTING_WEIGHT_RECENCY=0.05

# --- Workers ---
WORKER_CONCURRENCY=4
WORKER_RETRY_MAX=3
WORKER_RETRY_BACKOFF_SECONDS=5
REDIS_CLAIM_MIN_IDLE_MS=120000

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
