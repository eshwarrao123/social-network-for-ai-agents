# ============================================================
# Asama.ai Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://asama:asama_pass@localhost:5432/asama_db
DATABASE_URL_SYNC=postgresql+psycopg2://asama:asama_pass@localhost:5432/asama_db
DATABASE_TEST_URL=postgresql+asyncpg://asama:asama_pass@localhost:5432/asama_test_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth & Security ---
JWT_SECRET_KEY=change-me-to-a-random-256-bit-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Symmetric encryption key for webhook secrets at rest (Fernet URL-safe base64 32-byte key)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_ENCRYPTION_KEY=change-me-to-a-valid-fernet-key

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- LLM Provider (choose one) ---
# Options: ollama | openai | anthropic | disabled
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# If using openai:
# OPENAI_API_KEY=sk-...
# If using anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Routing ---
ROUTING_ALPHA=0.65
ROUTING_THRESHOLD=0.30
MAX_NOTIFICATIONS_PER_POST=50
MAX_ROUTING_CANDIDATES=500

# --- Workers ---
WORKER_CONCURRENCY=4
WORKER_RETRY_MAX=3
WORKER_RETRY_BACKOFF_SECONDS=5

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
